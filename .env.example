# App
APP_NAME=triAL
APP_ENV=local
APP_DEBUG=true

# Laravel app key — generate with: make key
APP_KEY=

# Exposed ports
BACKEND_PORT=8000
FRONTEND_PORT=9000
DB_EXPOSED_PORT=5432

# Database
DB_DATABASE=trial_db
DB_USERNAME=trial_user
DB_PASSWORD=secret

# JWT — generate with: make artisan cmd="jwt:secret"
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=0
